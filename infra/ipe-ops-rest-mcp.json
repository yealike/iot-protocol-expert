{
  "tools": [
    {
      "description": "按平台设备 SN、10 位平台枪号或第三方协议设备号定位设备",
      "name": "resolve_device",
      "annotations": {
        "readOnlyHint": true
      },
      "inputSchema": {
        "required": [
          "identifier",
          "_ipe_context"
        ],
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "protocol_hint": {
            "type": "string"
          },
          "_ipe_context": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "按平台设备 SN 查询最近报文摘要",
      "name": "list_device_frames",
      "annotations": {
        "readOnlyHint": true
      },
      "inputSchema": {
        "required": [
          "device_sn",
          "_ipe_context"
        ],
        "type": "object",
        "properties": {
          "device_sn": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "frame_type": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "_ipe_context": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "按平台设备 SN 锁定协议后解码指定帧",
      "name": "decode_device_frame",
      "annotations": {
        "readOnlyHint": true
      },
      "inputSchema": {
        "required": [
          "device_sn",
          "_ipe_context"
        ],
        "type": "object",
        "properties": {
          "device_sn": {
            "type": "string"
          },
          "frame_id": {
            "type": "integer"
          },
          "raw_frame": {
            "type": "string"
          },
          "_ipe_context": {
            "type": "string"
          }
        }
      }
    }
  ],
  "toolsMeta": {
    "resolve_device": {
      "enabled": true,
      "templates": {
        "json-go-template": {
          "requestTemplate": {
            "url": "/internal/ai/rest/resolve_device",
            "method": "POST",
            "argsToJsonBody": true
          }
        }
      }
    },
    "list_device_frames": {
      "enabled": true,
      "templates": {
        "json-go-template": {
          "requestTemplate": {
            "url": "/internal/ai/rest/list_device_frames",
            "method": "POST",
            "argsToJsonBody": true
          }
        }
      }
    },
    "decode_device_frame": {
      "enabled": true,
      "templates": {
        "json-go-template": {
          "requestTemplate": {
            "url": "/internal/ai/rest/decode_device_frame",
            "method": "POST",
            "argsToJsonBody": true
          }
        }
      }
    }
  }
}
