{
  "uid": "ipe-observability",
  "title": "IoT Protocol Expert · OpenTelemetry",
  "tags": [
    "iot",
    "opentelemetry",
    "jaeger"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "IPE Prometheus",
          "value": "ipe-prometheus"
        }
      },
      {
        "name": "application_name",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(ipe_protocol_operations_total, application_name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "active_profile",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(ipe_protocol_operations_total{application_name=~\"$application_name\"}, active_profile)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "personal",
          "value": "personal"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(ipe_protocol_operations_total{application_name=~\"$application_name\",active_profile=~\"$active_profile\"}, exported_instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(application_name) (rate(http_server_request_duration_seconds_count{application_name=~\"$application_name\",active_profile=~\"$active_profile\",exported_instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{application_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP P95 latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,application_name) (rate(http_server_request_duration_seconds_bucket{application_name=~\"$application_name\",active_profile=~\"$active_profile\",exported_instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{application_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "TCP operations / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(side,operation) (rate(ipe_protocol_operations_total{application_name=~\"$application_name\",active_profile=~\"$active_profile\",exported_instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{side}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "TCP P95 latency (processing / write / command RTT)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,side,operation) (rate(ipe_protocol_operation_duration_milliseconds_bucket{application_name=~\"$application_name\",active_profile=~\"$active_profile\",exported_instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{side}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "TCP failures and timeouts / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(side,operation,outcome) (rate(ipe_protocol_operations_total{application_name=~\"$application_name\",active_profile=~\"$active_profile\",exported_instance=~\"$instance\",outcome!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{side}} {{operation}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "TCP commands P99 round trip",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by(le,application_name) (rate(ipe_protocol_operation_duration_milliseconds_bucket{application_name=~\"$application_name\",active_profile=~\"$active_profile\",exported_instance=~\"$instance\",operation=\"request\"}[$__rate_interval])))",
          "legendFormat": "{{application_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 7,
      "title": "JVM memory used",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(application_name) (jvm_memory_used_bytes{application_name=~\"$application_name\",active_profile=~\"$active_profile\",exported_instance=~\"$instance\"})",
          "legendFormat": "{{application_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "JVM CPU utilization",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(application_name) (jvm_cpu_recent_utilization_ratio{application_name=~\"$application_name\",active_profile=~\"$active_profile\",exported_instance=~\"$instance\"})",
          "legendFormat": "{{application_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Structured logs — expand metadata; TraceID opens Jaeger",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "ipe-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$application_name\",deployment_environment_name=~\"$active_profile\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "links": [
    {
      "title": "Jaeger traces & service performance",
      "url": "http://localhost:16686",
      "targetBlank": true
    }
  ]
}
