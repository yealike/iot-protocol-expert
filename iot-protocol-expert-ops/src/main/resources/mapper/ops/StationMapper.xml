<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.yealike.ipe.ops.mapper.StationMapper">

    <resultMap id="StationMap" type="top.yealike.ipe.ops.domain.Station">
        <id property="id" column="id"/>
        <result property="stationCode" column="station_code"/>
        <result property="name" column="name"/>
        <result property="address" column="address"/>
        <result property="timezone" column="timezone"/>
        <result property="status" column="status"/>
        <result property="longitude" column="longitude"/>
        <result property="latitude" column="latitude"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="columns">
        id, station_code, name, address, timezone, status, longitude, latitude, created_at, updated_at
    </sql>

    <select id="selectById" resultMap="StationMap">
        select <include refid="columns"/>
        from ipe_ops.station
        where id = #{id}
    </select>

    <select id="selectByStationCode" resultMap="StationMap">
        select <include refid="columns"/>
        from ipe_ops.station
        where station_code = #{stationCode}
    </select>

    <select id="selectAll" resultMap="StationMap">
        select <include refid="columns"/>
        from ipe_ops.station
        order by id
    </select>

    <select id="selectByIds" resultMap="StationMap">
        select <include refid="columns"/>
        from ipe_ops.station
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by id
    </select>

    <select id="count" resultType="long">
        select count(*) from ipe_ops.station
    </select>

    <select id="countById" resultType="long">
        select count(*) from ipe_ops.station where id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into ipe_ops.station
            (station_code, name, address, timezone, status, longitude, latitude, created_at, updated_at)
        values
            (#{stationCode}, #{name}, #{address}, #{timezone}, #{status}, #{longitude}, #{latitude},
             #{createdAt}, #{updatedAt})
    </insert>

    <update id="update">
        update ipe_ops.station
        set station_code = #{stationCode},
            name = #{name},
            address = #{address},
            timezone = #{timezone},
            status = #{status},
            longitude = #{longitude},
            latitude = #{latitude},
            created_at = #{createdAt},
            updated_at = #{updatedAt}
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from ipe_ops.station where id = #{id}
    </delete>
</mapper>
