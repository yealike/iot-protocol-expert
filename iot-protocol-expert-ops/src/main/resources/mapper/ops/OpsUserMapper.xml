<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.yealike.ipe.ops.mapper.OpsUserMapper">

    <resultMap id="OpsUserMap" type="top.yealike.ipe.ops.domain.OpsUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="enabled" column="enabled"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectByUsername" resultMap="OpsUserMap">
        select id, username, password_hash, enabled, created_at
        from ipe_ops.ops_user
        where username = #{username}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into ipe_ops.ops_user (username, password_hash, enabled, created_at)
        values (#{username}, #{passwordHash}, #{enabled}, #{createdAt})
    </insert>
</mapper>
