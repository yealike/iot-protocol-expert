<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.yealike.pep.ops.audit.mapper.AuditLogMapper">

    <resultMap id="AuditLogMap" type="top.yealike.pep.ops.audit.domain.AuditLog">
        <id property="id" column="id"/>
        <result property="actor" column="actor"/>
        <result property="action" column="action"/>
        <result property="targetType" column="target_type"/>
        <result property="targetId" column="target_id"/>
        <result property="result" column="result"/>
        <result property="detail" column="detail"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectRecent" resultMap="AuditLogMap">
        select id, actor, action, target_type, target_id, result, detail, created_at
        from pep_domain.audit_log
        order by id desc
        limit #{limit}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into pep_domain.audit_log
            (actor, action, target_type, target_id, result, detail, created_at)
        values
            (#{actor}, #{action}, #{targetType}, #{targetId}, #{result}, #{detail}, #{createdAt})
    </insert>
</mapper>
