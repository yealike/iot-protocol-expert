<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.yealike.ipe.ops.mapper.ProtocolDocMapper">

    <resultMap id="ProtocolDocMap" type="top.yealike.ipe.ops.domain.ProtocolDoc">
        <id property="id" column="id"/>
        <result property="protocol" column="protocol"/>
        <result property="version" column="version"/>
        <result property="title" column="title"/>
        <result property="source" column="source"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectByProtocolAndVersion" resultMap="ProtocolDocMap">
        select id, protocol, version, title, source, created_at
        from ipe_ops.protocol_doc
        where protocol = #{protocol}
          and version = #{version}
    </select>
</mapper>
