# Copy to .env.local and fill in local values. scripts/start-local.ps1 loads it.
# IDE run configurations must load .env.local explicitly.

# Public demo key only. Set the same private 16/24-byte hex key on both services
# before connecting real devices. Encryption is disabled by default.
IPE_CRYPTO_KEY_HEX=0123456789ABCDEFFEDCBA9876543210

# 运维平台数据库（本机示例）。真实连接信息只放在本机环境变量中。
IPE_OPS_DB_URL=jdbc:postgresql://127.0.0.1:55432/ipe_ops
IPE_OPS_DB_USER=ipe
IPE_OPS_DB_PASSWORD=

# TDengine WebSocket，实际凭据只保存在本机环境变量。
IPE_TDENGINE_URL=jdbc:TAOS-WS://127.0.0.1:6041
IPE_TDENGINE_USER=root
IPE_TDENGINE_PASSWORD=

# 服务间身份与地址。令牌必须显式注入，示例不提供可用默认值。
IPE_OPS_SERVICE_TOKEN=
IPE_OPS_SIMULATOR_TOKEN=
IPE_OPS_BASE_URL=http://127.0.0.1:19082
IPE_PROTOCOL_BASE_URL=http://127.0.0.1:19080

# 模拟器启动时自动选中的平台设备 ID；为空则使用配置文件中的桩号。
# IPE_SIMULATOR_DEVICE_ID=1

# AI 访问运维服务仅通过 Higress MCP。共享令牌使用随机值，不提交到仓库。
# 入口优先使用 Nacos MCP 目录的 frontendEndpoints；缺失时由网关根地址与服务名拼出。
# IPE_AI_MCP_GATEWAY_BASE=http://100.101.91.38:8088
# IPE_AI_MCP_REGISTRY_ENABLED=true
# IPE_AI_MCP_SERVER_NAME=ipe-ops-rest
# IPE_AI_MCP_SERVER_VERSION=
# 目录不可用时的兜底入口；生产必须显式配置，不能依赖代码默认值。
# IPE_AI_MCP_URL=http://100.101.91.38:8088/ipe-mcp/ipe-ops-rest
IPE_AI_MCP_TOKEN=
IPE_NACOS_DISCOVERY_ENABLED=true
IPE_NACOS_SERVER_ADDR=100.101.91.38:8848
IPE_NACOS_USERNAME=
IPE_NACOS_PASSWORD=
IPE_OPS_ADVERTISE_IP=

# Nacos 服务注册与发现：沿用 spring-cloud-starter-alibaba-nacos-discovery，本地默认关闭。
# 共享环境开启后，ops 与 ai 都以 public/DEFAULT_GROUP 注册，带去环境/版本/角色元数据。
# IPE_NACOS_FAIL_FAST=true
# IPE_NACOS_DEREGISTER_WAIT_MS=3000
# IPE_AI_ADVERTISE_IP=

# AI 服务（19083）：默认复用 IPE_OPS_DB_URL，可用 IPE_AI_DB_* 单独指定。
# 模型未启用时，AI 助手仍执行确定性工具查询，并明确标注「未启用模型」。
# IPE_AI_DB_URL=
# IPE_AI_DB_USER=
# IPE_AI_DB_PASSWORD=
# IPE_AI_RUN_MAX_CONCURRENT=4
# IPE_AI_RUN_MAX_TOOL_CALLS=12
# IPE_AI_TOP_K=6

# 可选模型摘要端点（OpenAI 兼容）；不配置时排障仍返回确定性解析与证据时间线。
# AI 助手沿用同一组模型参数。
# IPE_MODEL_ENABLED=false
# IPE_MODEL_BASE_URL=
# IPE_MODEL_API_KEY=
# IPE_MODEL_NAME=deepseek-chat

# 可选的 Loki 查询地址，用于把集中日志作为排障证据。
# IPE_LOKI_URL=http://127.0.0.1:3100

# OpenTelemetry export to the shared Collector (traces, logs, metrics).
IPE_OTLP_ENABLED=true
IPE_OTLP_ENDPOINT=http://127.0.0.1:4318
IPE_ENVIRONMENT=local

# Set this to a local JDK 21 installation if JAVA_HOME points to another JDK.
IPE_JAVA_HOME=D:\develop\jdk\jdk-21
