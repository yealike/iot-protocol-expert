# Copy to .env.local and fill in local values. scripts/start-local.ps1 loads it.
# IDE run configurations must load .env.local explicitly.

# Public demo key only. Set the same private 16/24-byte hex key on both services
# before connecting real devices. Encryption is disabled by default.
IPE_CRYPTO_KEY_HEX=0123456789ABCDEFFEDCBA9876543210

# 运维平台数据库（本机示例）。真实连接信息只放在本机环境变量中。
IPE_OPS_DB_URL=jdbc:postgresql://127.0.0.1:55432/ipe_ops
IPE_OPS_DB_USER=ipe
IPE_OPS_DB_PASSWORD=

# 模拟器数据库：默认复用以上 PostgreSQL 连接，但始终使用独立 ipe_simulator schema。
# 可按需使用独立数据库或账号；旧状态文件只在该设备尚无数据库快照时只读导入。
# IPE_SIMULATOR_DB_URL=jdbc:postgresql://127.0.0.1:55432/ipe_ops
# IPE_SIMULATOR_DB_USER=ipe
# IPE_SIMULATOR_DB_PASSWORD=
# IPE_SIMULATOR_LEGACY_STATE_FILE=./data/simulator-state.properties

# TDengine WebSocket，实际凭据只保存在本机环境变量。
IPE_TDENGINE_URL=jdbc:TAOS-WS://127.0.0.1:6041
IPE_TDENGINE_USER=root
IPE_TDENGINE_PASSWORD=

# 服务间身份与地址。令牌必须显式注入，示例不提供可用默认值。
IPE_OPS_SERVICE_TOKEN=
IPE_OPS_SIMULATOR_TOKEN=
IPE_OPS_BASE_URL=http://127.0.0.1:19082
IPE_PROTOCOL_BASE_URL=http://127.0.0.1:19080

# 模拟器启动时自动选中的平台设备 ID；为空则使用配置文件中的桩号。
# IPE_SIMULATOR_DEVICE_ID=1

# AI 访问运维服务仅通过 Higress MCP。共享令牌使用随机值，不提交到仓库。
# 入口优先使用 Nacos MCP 目录的 frontendEndpoints；缺失时由网关根地址与服务名拼出。
# 下方是明显占位符，必须替换为实际 Higress 网关地址。
IPE_AI_MCP_GATEWAY_BASE=http://higress.example.internal:8088
# IPE_AI_MCP_REGISTRY_ENABLED=true
# IPE_AI_MCP_SERVER_NAME=ipe-ops-rest
# IPE_AI_MCP_SERVER_VERSION=
# 目录不可用时的兜底入口；生产必须显式配置，不能依赖代码默认值。
# IPE_AI_MCP_URL=http://higress.example.internal:8088/ipe-mcp/ipe-ops-rest
IPE_AI_MCP_TOKEN=
IPE_NACOS_DISCOVERY_ENABLED=true
IPE_NACOS_SERVER_ADDR=nacos.example.internal:8848
# IPE_NACOS_NAMESPACE=public
# IPE_NACOS_GROUP=DEFAULT_GROUP
IPE_NACOS_USERNAME=
IPE_NACOS_PASSWORD=
IPE_OPS_ADVERTISE_IP=

# Nacos 服务注册与发现：沿用 spring-cloud-starter-alibaba-nacos-discovery。
# 使用 Nacos/Higress 时必须开启；OPS 未注册 iot-protocol-expert-ops 会导致 tools/call 503。
# 共享环境开启后，ops 与 ai 都以 public/DEFAULT_GROUP 注册，带去环境/版本/角色元数据。
# IPE_NACOS_FAIL_FAST=true
# IPE_NACOS_DEREGISTER_WAIT_MS=3000
# IPE_AI_ADVERTISE_IP=

# AI 服务（19083）：默认复用 IPE_OPS_DB_URL，可用 IPE_AI_DB_* 单独指定。
# 模型未启用时，AI 助手仍执行确定性工具查询，并明确标注「未启用模型」。
# IPE_AI_DB_URL=
# IPE_AI_DB_USER=
# IPE_AI_DB_PASSWORD=
# IPE_AI_RUN_MAX_CONCURRENT=4
# IPE_AI_RUN_MAX_TOOL_CALLS=12
# IPE_AI_TOP_K=6

# 在线 Agent 平台（Control 19083 / Runtime 19084）。
# OPS 还必须启用下方 IPE_NACOS_DISCOVERY_ENABLED=true，并以 iot-protocol-expert-ops
# 注册到 Nacos；否则 Higress 的 MCP tools/call 会返回 503。
# IPE_AI_REGISTRY_ENABLED 控制 Control/Runtime/Agent/MCP/Skill 的平台 Naming 注册；
# IPE_AI_MCP_REGISTRY_ENABLED 只控制 Nacos MCP 目录订阅，二者不能互相替代。
# 使用 Nacos/Higress 时显式改为 true；本地纯直连可保持 false。
IPE_AI_REGISTRY_ENABLED=false
IPE_AI_COMPONENT_GROUP=IPE_AI_COMPONENTS
# IPE_AI_ADVERTISE_IP=
# IPE_RUNTIME_ADVERTISE_IP=
IPE_RUNTIME_PORT=19084
IPE_CONTROL_BASE_URL=http://127.0.0.1:19083
IPE_AGENT_RUNTIME_BASE_URL=http://127.0.0.1:19084
# 仅本地无 Nacos 调试时开启；生产必须保持 false，Nacos 无健康实例时新 Run 直接失败。
# IPE_RUNTIME_DIRECT_FALLBACK_ENABLED=false
# seed-ai.ps1 启动 Control 时会临时覆盖为 true。
IPE_AI_BOOTSTRAP_ENABLED=false

# 内部服务 HMAC。Control 与 Runtime 必须一致，真实值只放本机或密钥文件。
# 下方仅为明显占位，复制到 .env.local 后必须替换，禁止用于生产。
IPE_INTERNAL_SERVICE_KEY=change-me-shared-hmac-secret
# Runtime 还支持文件方式；Control 当前只读取 IPE_INTERNAL_SERVICE_KEY。
# IPE_INTERNAL_SERVICE_KEY_FILE=
IPE_INTERNAL_SERVICE_NAME=control
IPE_RUNTIME_SERVICE_NAME=runtime
IPE_RUNTIME_KEY_ID=runtime
IPE_INTERNAL_KEY_ID=control
# 同时影响 Runtime 期望的 Control 服务身份和 Control 的平台 Nacos 服务名；
# 两者默认值不同（control / ipe-ai-control），通常不要显式设置。
# IPE_CONTROL_SERVICE_NAME=control

# 凭据主密钥。生产必须使用稳定的随机值或挂载文件；密钥变化后旧密文不可解密。
# 下方仅为明显占位，复制到 .env.local 后必须替换，禁止用于生产。
IPE_CREDENTIAL_MASTER_KEY=change-me-credential-master-key
# IPE_CREDENTIAL_MASTER_KEY_FILE=

# Run 调度与 Runtime 容量（按需开启）。
# IPE_RUNTIME_MAX_DISPATCH_ATTEMPTS=3
# IPE_RUNTIME_LEASE_SECONDS=30
# IPE_RUNTIME_QUEUE_LIMIT=100
# IPE_RUNTIME_PER_USER_QUEUED=2
# IPE_RUNTIME_PER_USER_IN_FLIGHT=1
# IPE_RUNTIME_MAX_ACTIVE=4
# IPE_RUNTIME_QUEUE_CAPACITY=8

# 可选模型摘要端点（OpenAI 兼容）；不配置时排障仍返回确定性解析与证据时间线。
# AI 助手沿用同一组模型参数。
# IPE_MODEL_ENABLED=false
# IPE_MODEL_BASE_URL=
# IPE_MODEL_API_KEY=
# IPE_MODEL_NAME=deepseek-chat

# 可选的 Loki 查询地址，用于把集中日志作为排障证据。
# IPE_LOKI_URL=http://127.0.0.1:3100

# OpenTelemetry export to the shared Collector (traces, logs, metrics).
IPE_OTLP_ENABLED=true
IPE_OTLP_ENDPOINT=http://127.0.0.1:4318
IPE_ENVIRONMENT=local

# AI Trace 默认只导出 Agent / 模型 / 工具元数据与 token 用量。
# 仅本地排障时临时开启正文；开启后会按最大长度截断并做常见凭据脱敏。
# IPE_AI_OTEL_ENABLED=true
# IPE_AI_OTEL_CONTENT_ENABLED=false
# IPE_AI_OTEL_MAX_CONTENT_CHARS=8192

# Set this to a local JDK 21 installation if JAVA_HOME points to another JDK.
IPE_JAVA_HOME=D:\develop\jdk\jdk-21
