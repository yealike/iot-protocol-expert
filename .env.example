# 复制为 .env.local 后填写。脚本只解析 KEY=VALUE，不执行文件内容。
# 真实密码、访问令牌、供应商 Key 只放 .env.local 或部署环境，禁止提交。

IPE_ENVIRONMENT=local
IPE_JAVA_HOME=D:\develop\jdk\jdk-21

# ---------------------------------------------------------------- PostgreSQL
# OPS 与 Agent Control 连接同一个现有数据库；历史迁移由 OPS 执行，先启动 OPS。
# pep_platform / pep_domain / pep_agent
PEP_CONTROL_DB_URL=jdbc:postgresql://127.0.0.1:55432/ipe_ops
PEP_CONTROL_DB_USER=ipe
PEP_CONTROL_DB_PASSWORD=
# 计量账本：pep_metering；未配置时复用控制面连接
# PEP_METERING_DB_URL=
# PEP_METERING_DB_USER=
# PEP_METERING_DB_PASSWORD=
# 兼容旧脚本的别名；新配置优先使用 PEP_CONTROL_DB_*
# IPE_OPS_DB_URL=
# IPE_OPS_DB_USER=
# IPE_OPS_DB_PASSWORD=

# 模拟器使用独立 schema；默认复用控制面连接
# IPE_SIMULATOR_DB_URL=
# IPE_SIMULATOR_DB_USER=
# IPE_SIMULATOR_DB_PASSWORD=
# IPE_SIMULATOR_DEVICE_ID=1

# ---------------------------------------------------------------- TDengine
IPE_TDENGINE_URL=jdbc:TAOS-WS://127.0.0.1:6041
IPE_TDENGINE_USER=root
IPE_TDENGINE_PASSWORD=

# ---------------------------------------------------------------- 本地端口
IPE_OPS_PORT=19082
PEP_CONTROL_PORT=19083
PEP_MODEL_GATEWAY_PORT=19085
IPE_RUNTIME_PORT=19084
# 设备网关 HTTP 19080、YKC TCP 8768、OCPP WS 8769；模拟器 19081 固定。

# ---------------------------------------------------------------- 服务身份
# 网关管理/查询接口共享令牌；Control 与 Gateway 必须一致。
PEP_MODEL_GATEWAY_SERVICE_TOKEN=change-me-model-gateway-token
# Control 与 Runtime 的内部 HMAC 密钥；必须一致。
IPE_INTERNAL_SERVICE_KEY=change-me-internal-hmac-secret
IPE_INTERNAL_SERVICE_NAME=iot-protocol-expert-agent-control
IPE_RUNTIME_SERVICE_NAME=iot-protocol-expert-agent-runtime
IPE_RUNTIME_KEY_ID=runtime
IPE_CONTROL_SERVICE_NAME=iot-protocol-expert-agent-control
IPE_OPS_SERVICE_NAME=iot-protocol-expert-ops

# 供应商密钥加密主密钥；只由模型网关读取。轮换后旧密文不可解密。
PEP_CREDENTIAL_MASTER_KEY=change-me-credential-master-key
# PEP_CREDENTIAL_MASTER_KEY_FILE=

# 设备网关/模拟器调用控制面的兼容令牌
IPE_OPS_SERVICE_TOKEN=change-me-service-token
IPE_OPS_SIMULATOR_TOKEN=change-me-simulator-token

# ---------------------------------------------------------------- 地址
IPE_OPS_BASE_URL=http://127.0.0.1:19082
IPE_CONTROL_BASE_URL=http://127.0.0.1:19083
IPE_AGENT_RUNTIME_BASE_URL=http://127.0.0.1:19084
PEP_MODEL_GATEWAY_BASE_URL=http://127.0.0.1:19085
IPE_PROTOCOL_BASE_URL=http://127.0.0.1:19080
IPE_SIMULATOR_BASE_URL=http://127.0.0.1:19081
IPE_PROTOCOL_DOCUMENT_DIR=./data/protocol-documents

# ---------------------------------------------------------------- 可选模型
# 逻辑模型 key 在模型中登记；上游地址与密钥只在模型网关管理 API 写入。
# IPE_MODEL_NAME=deepseek-default
# IPE_MODEL_API_KEY=
# IPE_MODEL_BASE_URL=
# IPE_MODEL_MAX_TOKENS=2048

# ---------------------------------------------------------------- Nacos（可选）
IPE_NACOS_DISCOVERY_ENABLED=false
# IPE_NACOS_SERVER_ADDR=nacos.example.internal:8848
# IPE_NACOS_NAMESPACE=public
# IPE_NACOS_GROUP=DEFAULT_GROUP
# IPE_NACOS_USERNAME=
# IPE_NACOS_PASSWORD=
IPE_AI_REGISTRY_ENABLED=false
# 旧变量保留兼容，系统 MCP 入口不再从 Nacos 解析。
IPE_AI_MCP_REGISTRY_ENABLED=false
# 本地无 Nacos 时显式允许 Runtime 直连；部署环境按需关闭。
IPE_RUNTIME_DIRECT_FALLBACK_ENABLED=true
# IPE_AI_MCP_GATEWAY_BASE=https://higress.example.internal
# Higress 实际路由可以自定义；建议使用带版本的 MCP 路由。
# IPE_AI_MCP_URL=https://higress.example.com/mcp/ops/v1
# IPE_AI_MCP_TOKEN=

# 本地引导：发布 MCP/Skill/Agent；不写上游凭据。
IPE_AI_BOOTSTRAP_ENABLED=false

# ---------------------------------------------------------------- 观测
IPE_OTLP_ENABLED=false
IPE_OTLP_ENDPOINT=http://127.0.0.1:4318
# IPE_AI_OTEL_ENABLED=false
# IPE_AI_OTEL_CONTENT_ENABLED=false
# IPE_AI_OTEL_MAX_CONTENT_CHARS=8192
# IPE_LOKI_URL=http://127.0.0.1:3100
