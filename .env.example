# Copy desired values into your shell / IDE environment or an ignored .env file.
# Spring Boot does not automatically read .env files; import/export them yourself.

# Public demo key only. Set the same private 16/24-byte hex key on both services
# before connecting real devices. Encryption is disabled by default.
IPE_CRYPTO_KEY_HEX=0123456789ABCDEFFEDCBA9876543210

# OpenTelemetry export to the shared Collector (traces, logs, metrics).
IPE_OTLP_ENABLED=true
IPE_OTLP_ENDPOINT=http://100.101.91.38:4318
IPE_ENVIRONMENT=local

# Set this to a local JDK 21 installation if JAVA_HOME points to another JDK.
# IPE_JAVA_HOME=/path/to/jdk-21