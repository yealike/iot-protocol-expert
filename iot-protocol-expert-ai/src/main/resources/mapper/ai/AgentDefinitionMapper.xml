<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.yealike.ipe.ai.mapper.AgentDefinitionMapper">

    <resultMap id="DefinitionMap" type="top.yealike.ipe.ai.agent.AgentCatalog$Definition">
        <constructor>
            <arg column="agent_key" javaType="java.lang.String"/>
            <arg column="version" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="kind" javaType="java.lang.String"/>
            <arg column="description" javaType="java.lang.String"/>
            <arg column="sys_prompt" javaType="java.lang.String"/>
            <arg column="model_key" javaType="java.lang.String"/>
            <arg column="allowed_tools" javaType="java.util.Set" typeHandler="top.yealike.ipe.ai.mybatis.JsonStringSetTypeHandler"/>
            <arg column="status" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="listPublished" resultMap="DefinitionMap">
        select * from ai_agent_definition where status = 'PUBLISHED' order by agent_key
    </select>

    <select id="find" resultMap="DefinitionMap">
        select * from ai_agent_definition where agent_key = #{agentKey} and status = 'PUBLISHED' order by published_at
            desc limit 1
    </select>
</mapper>
